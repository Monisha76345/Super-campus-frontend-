# Backend base URL, including the API prefix.
# The Android emulator rewrites localhost to 10.0.2.2 so this still reaches the Mac.
EXPO_PUBLIC_API_URL=http://172.17.41.121:3001/api/v1

# Campus code sent as tenantId and X-Tenant-Id.
EXPO_PUBLIC_TENANT_ID=nmit

# College mailbox allowed on the login form.
EXPO_PUBLIC_EMAIL_DOMAIN=nmit.ac.in
